# Supabase — pegue esses valores em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (mesma página) — ignora RLS. Só usada no servidor (webhook
# do Stripe e exclusão de conta). NUNCA use o prefixo NEXT_PUBLIC_ aqui.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (CAPTCHA anti-bot/brute-force no login, signup e reset).
# A verificação é feita no NOSSO backend via siteverify (ver lib/turnstile.ts),
# não no Supabase. Duas variáveis:
#   - Site key (pública, vai no HTML do widget). Sem ela o widget não renderiza.
#   - Secret (privada, só no servidor). As duas são obrigatórias em produção:
#     sem o secret, o backend bloqueia autenticação; em desenvolvimento local,
#     a verificação pode ser ignorada para não impedir o trabalho sem credenciais.
# Pegue as duas no widget do Turnstile em https://dash.cloudflare.com/?to=/:account/turnstile
#
# EM DESENVOLVIMENTO, use as chaves de teste que a própria Cloudflare publica
# (documentadas em https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
# Elas não são segredo e o widget sempre aprova — sem isso os testes de ponta
# a ponta travam no CAPTCHA, que nunca emite token em navegador automatizado:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Existem também as versões que sempre reprovam (trocar o 1x inicial por 2x),
# úteis para testar o caminho de erro do login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Stripe (assinatura Pro) — pegue em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-key
# Gerado por `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# em dev, ou pelo endpoint configurado no dashboard em produção.
STRIPE_WEBHOOK_SECRET=whsec_your-secret
# Rode `node scripts/create-stripe-price.mjs` (depois de preencher
# STRIPE_SECRET_KEY acima) para criar o produto/preço e obter esse valor.
STRIPE_PRICE_ID_PRO=price_your-price-id

# Claude (assistente de IA) — crie a chave em https://platform.claude.com
# Fica só no servidor; nunca use o prefixo NEXT_PUBLIC_ aqui.
ANTHROPIC_API_KEY=sk-ant-your-key

# Provedor do assistente: "anthropic" (padrão quando disponível) ou "openai".
# Se o provedor escolhido não tiver chave, o assistente permanece indisponível.
AI_PROVIDER=anthropic

# OpenAI Realtime (voz em tempo real) - crie a chave em https://platform.openai.com/api-keys
# Fica so no servidor; nunca use o prefixo NEXT_PUBLIC_ aqui.
OPENAI_API_KEY=sk-your-openai-key

# Evolution API (WhatsApp self-hosted) — URL base do seu servidor Evolution
# (ex: https://evolution.seu-vps.com, sem barra no final) e a apikey global
# configurada nele (AUTHENTICATION_API_KEY no .env do Evolution). Ficam só no
# servidor; nunca use o prefixo NEXT_PUBLIC_ aqui.
EVOLUTION_API_URL=https://evolution.seu-vps.com
EVOLUTION_API_KEY=your-evolution-global-api-key
EVOLUTION_WEBHOOK_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# DataJud (API Pública do CNJ) — chave compartilhada e gratuita, documentada
# em https://datajud-wiki.cnj.jus.br/api-publica/acesso/. O CNJ pode trocá-la
# a qualquer momento; se a sincronização de processos parar de funcionar,
# confira a página acima antes de qualquer outra coisa.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Segredo do cron job de sincronização do DataJud (/api/cron/datajud-sync) —
# gere um valor aleatório qualquer; a Vercel envia esse valor automaticamente
# como "Authorization: Bearer <valor>" nas chamadas agendadas (vercel.json),
# e a rota rejeita qualquer requisição sem ele.
CRON_SECRET=generate-a-random-secret

# Autentique (assinatura eletrônica de documentos jurídicos) — só necessária
# no workspace de advocacia. Gere o token em
# https://painel.autentique.com.br/perfil/api. O webhook secret é configurado
# junto do endpoint em Configurações > Webhooks, apontando para
# <SITE_URL>/api/webhooks/autentique (eventos signature.viewed/accepted/
# rejected/delivery_failed). Ficam só no servidor; nunca use NEXT_PUBLIC_.
AUTENTIQUE_API_TOKEN=your-autentique-api-token
AUTENTIQUE_WEBHOOK_SECRET=your-autentique-webhook-secret

# Web Push (notificações de lembretes hoje/atrasados) — gere o par com
# `node scripts/generate-vapid-keys.mjs` e cole a saída aqui. A pública é
# exposta ao navegador (NEXT_PUBLIC_), a privada fica só no servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:suporte@useotimizia.com

# Resend (e-mail transacional: resumo diário e alerta de venda parada) —
# crie a chave em https://resend.com/api-keys. Fica só no servidor.
RESEND_API_KEY=re_your-resend-key
# Remetente de e-mail que a pessoa pode responder (convite de equipe,
# boas-vindas). A caixa precisa existir e ser lida por alguém.
RESEND_FROM_EMAIL=OtimizIA <avisos@useotimizia.com>
# Remetente dos disparos automáticos e recorrentes (resumo diário, alerta de
# venda parada). Alias sem caixa de entrada — ver docs/EMAIL_DNS.md para o
# passo a passo de SPF, DKIM e DMARC antes de mandar o primeiro lote.
RESEND_NOREPLY_EMAIL=OtimizIA <noreply@useotimizia.com>

# Medição e anúncios. TODAS são opcionais: sem o valor, a tag simplesmente não
# entra na página. Mesmo preenchidas, nenhuma carrega antes do "sim" no banner
# de cookies (ver components/SiteAnalytics.tsx) — analytics exige a categoria
# de medição, os dois pixels exigem a de publicidade.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# URL pública do site, sem barra no final. Usada como fonte de verdade em
# lib/request-origin.ts para montar links de e-mail e URLs de redirect do
# Stripe — deixe SEM essa variável em dev (cai no fallback via headers, que
# resolve pra localhost sozinho). EM PRODUÇÃO É OBRIGATÓRIA: sem ela, esses
# links usam o header Host/X-Forwarded-Host da requisição, que pode ser
# forjado pelo cliente.
SITE_URL=https://useotimizia.com

# Conta demo do corretor (só desenvolvimento). O atalho "corretor@corretor" na
# tela de login é traduzido para essas credenciais em lib/demo-account.ts, e só
# funciona fora de produção. A SENHA NÃO TEM PADRÃO NO CÓDIGO: sem esta
# variável o atalho não funciona e o seed em scripts/seed-real-estate-demo.mjs
# se recusa a rodar. Isso é proposital — o repositório é público, e enquanto a
# senha ficou fixa no arquivo ela valia na tela de login de produção, onde a
# trava de ambiente não alcança. Se você já rodou com o valor antigo, troque a
# senha dessa conta no Supabase de produção.
BROKER_DEMO_AUTH_EMAIL=corretor.demo.otimizia@gmail.com
BROKER_DEMO_AUTH_PASSWORD=

# Conta descartável usada pelos testes de ponta a ponta (npm run test:e2e).
# Sem as duas, os testes autenticados são pulados em vez de falhar — os
# públicos continuam rodando. Crie o usuário pelo painel do Supabase; o
# gatilho handle_new_user já cria perfil e organização sozinho, não precisa
# preparar mais nada. Não reaproveite uma conta real: os testes escrevem
# dados. Nunca versione os valores.
E2E_EMAIL=
E2E_PASSWORD=
# Opcionais: apontar os testes para uma URL já no ar em vez de subir o dev
# server local, e pré-aceitar o banner de cookies (ver playwright.config.ts).
E2E_BASE_URL=
E2E_CONSENT_COOKIE_NAME=
E2E_CONSENT_COOKIE_VALUE=
